# Perfil de LLM (ver config/llm_profiles.yaml quando existir). Por enquanto: endpoint direto.
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=bonsai
LLM_API_KEY=none
LLM_TEMPERATURE=0.2

# Data "de hoje" usada nas regras de prazo (pedidos do dataset vão até 2026-03-22).
REFERENCE_DATE=2026-03-25

# Logs: DEBUG | INFO | WARNING | ERROR ; formato text (terminal) | json (coleta)
LOG_LEVEL=INFO
LOG_FORMAT=text

# Caminhos (relativos à raiz do projeto)
# DATA_RAW_DIR=data/raw
# DATA_PROCESSED_DIR=data/processed
