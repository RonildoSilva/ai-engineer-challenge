# Perfil de LLM (config/llm_profiles.yaml): bonsai (local, padrão), ollama-qwen2.5-3b, anthropic, openai
LLM_PROFILE=bonsai
# Chaves dos perfis online (só se for usá-los):
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# Sobrescritas opcionais do perfil ativo:
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=bonsai
# LLM_TEMPERATURE=0.2

# Data "de hoje" usada nas regras de prazo (pedidos do dataset vão até 2026-03-22).
REFERENCE_DATE=2026-03-25

# Logs: DEBUG | INFO | WARNING | ERROR ; formato text (terminal) | json (coleta)
LOG_LEVEL=INFO
LOG_FORMAT=text

# Caminhos (relativos à raiz do projeto)
# DATA_RAW_DIR=data/raw
# DATA_PROCESSED_DIR=data/processed

# Embeddings e busca híbrida
# llamafile: servidor local (sobe sozinho no pipeline/CLI se o modelo estiver baixado)
# fake: determinístico, sem modelo (testes) · none: só busca lexical
EMBEDDING_BACKEND=llamafile
EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
# Similaridade mínima para um resultado vetorial contar (calibrada: docs/embeddings_eval.md)
RETRIEVAL_MIN_SIMILARITY=0.30

# Histórico de conversas (data/processed/history.db): mensagens retomadas ao continuar uma sessão
HISTORY_WINDOW=20

# Perfil de escala (requer `uv sync --extra scale` e um Postgres com pgvector; ver README › Escala)
# STORE_BACKEND=postgres
# VECTOR_BACKEND=pgvector
# HISTORY_BACKEND=postgres
# DATABASE_URL=postgresql://emporio:emporio@127.0.0.1:5432/emporio
